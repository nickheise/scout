---
/**
 * TerminalFrame — the site's terminal chrome, paper-register (PLAN.md §3,
 * PRD §5). NOT a black terminal: a cream card with a warm border and a
 * labeled tab, the way a field notebook page reads, not an xterm window.
 * Content inside is set in the mono typeface (iA Writer Mono) — mono is
 * used only inside this frame, per brand rule.
 *
 * This is chrome only. The Beat 2 demo's animation lives in the
 * TerminalDemo island; a static <TerminalFrame> with plain markup in the
 * slot is exactly what the v0 "static screenshot sequence" fallback needs
 * (D-003) — no rework when the real player lands.
 */
interface Props {
  /** Window-title slot text, e.g. a working directory or command name. */
  title?: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<div
  class:list={[
    "overflow-hidden rounded-xl border border-ink/15 bg-paper-50 shadow-[0_1px_2px_rgba(0,0,0,0.04),0_8px_24px_-12px_rgba(0,0,0,0.12)]",
    className,
  ]}
>
  <div
    class="flex items-center gap-2 border-b border-ink/10 bg-paper-200/70 px-4 py-2.5"
  >
    <svg
      width="14"
      height="14"
      class="shrink-0 text-trail"
      aria-hidden="true"
      focusable="false"
    >
      <use href="#icon-waypoint" />
    </svg>
    {
      title && (
        <p class="truncate font-mono text-xs text-ink-muted">{title}</p>
      )
    }
  </div>
  <div
    class="overflow-x-auto p-4 font-mono text-sm text-ink [overflow-wrap:anywhere] sm:p-5"
  >
    <slot />
  </div>
</div>
