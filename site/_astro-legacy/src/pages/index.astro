---
// Single page, six beats, in PRD §3 order. After the P0 scaffold phase,
// nobody touches this file — section content lands inside each
// src/sections/*.astro file instead.
import Layout from "../layouts/Layout.astro";
import Hero from "../sections/Hero.astro";
import Demo from "../sections/Demo.astro";
import HowItWorks from "../sections/HowItWorks.astro";
import Philosophy from "../sections/Philosophy.astro";
import TracksPrompt from "../sections/TracksPrompt.astro";
import Install from "../sections/Install.astro";
import Footer from "../sections/Footer.astro";
---

<Layout>
  <main>
    <Hero />
    <Demo />
    <HowItWorks />
    <Philosophy />
    <TracksPrompt />
    <Install />
  </main>
  <Footer />
</Layout>
