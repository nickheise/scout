---
import "../styles/global.css";
import { SITE } from "../config";
import IconSprite from "../components/IconSprite.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.siteTitle, description = SITE.siteDescription } =
  Astro.props;

// Head hygiene (P4): canonical + absolute OG image URL derive from
// SITE.domain (src/config.ts) — the D-004 name swap updates these too.
const canonicalUrl = new URL(Astro.url.pathname, `https://${SITE.domain}`);
const ogImageUrl = new URL("/og.png", `https://${SITE.domain}`);

// Favicon: the icon sprite's waypoint mark (IconSprite.astro), inlined as a
// data URI — forest-600 stroke, thickened for favicon scale.
const favicon =
  "data:image/svg+xml," +
  encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#184829" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21V11"/><path d="M12 3.5 16 8l-4 4-4-4Z"/></svg>`,
  );

// Section rhythm: every section/footer opts into the shared max-width
// container by wrapping its content in a `.container-field` element
// (utility defined in styles/global.css) — background treatments (e.g. the
// `.topo-wash` masked gradient wash, paired with a per-section
// `.topo-wash-*` bloom recipe) stay on the outer <section>, full-bleed,
// while the container constrains the content column. Baseline vertical
// spacing is applied globally to `section[data-beat]` / `footer[data-beat]`.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f6f1e6" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={favicon} />

    <!-- Social cards: og.png is generated at build time (src/pages/og.png.ts,
    Satori + resvg) — paper-register card with the install command legible
    per PRD §6. -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`Scout — ${SITE.installCommand}`}
    />
    <meta name="twitter:card" content="summary_large_image" />

    {
      /* GoatCounter — injected ONLY when SITE.goatcounter is set (analytics
       * gated honestly: no site code, no script, and Footer.astro's
       * disclosure line stays out of the page too). count.js is a no-op-safe
       * external script; CopyBlock's window.goatcounter?.count events start
       * working the moment this ships. */
      SITE.goatcounter && (
        <script
          is:inline
          async
          data-goatcounter={`https://${SITE.goatcounter}.goatcounter.com/count`}
          src="https://gc.zgo.at/count.js"
        />
      )
    }

    <!-- Self-hosted fonts (D-012): preload only the two families used
    above the fold (display heading + body). iA Writer Mono lives inside
    terminal frames further down the page and isn't preload-critical. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/fraunces/Fraunces-Variable-latin.woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/general-sans/GeneralSans-Variable-latin.woff2"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <IconSprite />
    <slot />
  </body>
</html>
