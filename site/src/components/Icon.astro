---
/**
 * Renders one glyph from the field-guide icon sprite (IconSprite.astro) via
 * <use>. PLAN.md §3 glyph set: pack, waypoint, compass, contour, stamp,
 * arrow — plus blaze, tracks, cairn (docs/visual-language.md §4, D-019) and
 * copy/check (CopyBlock's copy-state swap).
 *
 * Decorative by default (aria-hidden). Pass `label` when the icon carries
 * meaning on its own (no adjacent visible text) to expose it to assistive
 * tech as an accessible image instead.
 */
export type IconName =
  | "pack"
  | "waypoint"
  | "compass"
  | "contour"
  | "stamp"
  | "arrow"
  | "blaze"
  | "tracks"
  | "cairn"
  | "copy"
  | "check";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
}

const { name, size = 24, class: className, label } = Astro.props;
---

<svg
  width={size}
  height={size}
  class={className}
  aria-hidden={label ? undefined : "true"}
  aria-label={label}
  role={label ? "img" : undefined}
  focusable="false"
>
  <use href={`#icon-${name}`} />
</svg>
