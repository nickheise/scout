---
/**
 * Hand-drawn field-guide icon sprite (PLAN.md §3, PRD §5).
 *
 * One inline SVG containing every bespoke glyph as a <symbol>, rendered once
 * near the top of <body> (see Layout.astro). Individual icons are drawn via
 * <Icon name="..." /> (Icon.astro), which references these symbols with
 * <use href="#icon-<name>">. Symbols never paint on their own — this block
 * is visually hidden but always present in the DOM.
 *
 * House style, matched to the Lucide convention: 24x24 grid, 1.75px stroke,
 * round caps/joins, stroke=currentColor, no fills. `copy` and `check` are
 * extras (not in the PLAN §3 glyph list) added so CopyBlock's copy-state
 * swap can use the same sprite instead of a second icon system.
 */
---

<svg
  aria-hidden="true"
  style="position: absolute; width: 0; height: 0; overflow: hidden;"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <!-- pack / rucksack -->
    <symbol
      id="icon-pack"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M8.5 9V6.5a3.5 3.5 0 0 1 7 0V9" />
      <rect x="5" y="9" width="14" height="12" rx="3" />
      <path d="M9 21v-5.5" />
      <path d="M15 21v-5.5" />
      <path d="M9.5 13.5h5" />
    </symbol>

    <!-- waypoint marker (trail blaze on a stake) -->
    <symbol
      id="icon-waypoint"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M12 21V11" />
      <path d="M12 3.5 16 8l-4 4-4-4Z" />
    </symbol>

    <!-- compass -->
    <symbol
      id="icon-compass"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="12" cy="12" r="9" />
      <path d="M14.5 8 12.5 13 9.5 16l2-5Z" />
    </symbol>

    <!-- contour lines -->
    <symbol
      id="icon-contour"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M2.5 8c3-3 6-3 9 0s6 3 9 0" />
      <path d="M2.5 13.5c3-3 6-3 9 0s6 3 9 0" />
      <path d="M2.5 19c3-3 6-3 9 0s6 3 9 0" />
    </symbol>

    <!-- stamp / badge frame -->
    <symbol
      id="icon-stamp"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="12" cy="9.5" r="6" />
      <circle cx="12" cy="9.5" r="2.75" />
      <path d="M8.5 14.75 6.5 21l5.5-2.75L17.5 21l-2-6.25" />
    </symbol>

    <!-- arrow -->
    <symbol
      id="icon-arrow"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M4.5 12h15" />
      <path d="M13 5.5 19.5 12 13 18.5" />
    </symbol>

    <!-- copy (extra: CopyBlock default state) -->
    <symbol
      id="icon-copy"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect x="9" y="9" width="11" height="11" rx="2" />
      <path d="M6 15H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v1" />
    </symbol>

    <!-- check (extra: CopyBlock copied state) -->
    <symbol
      id="icon-check"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M5 12.5 9.5 17 19 6.5" />
    </symbol>
  </defs>
</svg>
