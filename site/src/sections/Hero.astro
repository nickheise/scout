---
// Beat 1 — Hero (PRD §3, copy-deck.md Beat 1). This is the page's LCP: the
// headline and subhead are plain static Astro markup (no island, no image),
// so they paint immediately. The two interactive bits — the install
// CopyBlock and the GitHub/StarCount link — are React islands that hydrate
// `client:idle` (PLAN.md §1); their text content is still server-rendered,
// so nothing here waits on JS to become visible.
import { SITE } from "../config";
import type { HeroVariant } from "../config";
import { CopyBlock } from "../components/CopyBlock";
import { StarCount } from "../components/StarCount";

// All three PRD headline directions (D-006) live here as swappable
// variants; SITE.heroVariant ("A" by default) picks the one that renders.
// Verbatim from docs/copy-deck.md Beat 1 — do not paraphrase.
const HEADLINES: Record<HeroVariant, string> = {
  A: "You keep finding great libraries. Then you forget they exist.",
  B: "Your bookmarks are where good libraries go to die.",
  C: "Be prepared.",
};

const headline = HEADLINES[SITE.heroVariant];
---

<section id="hero" data-beat="1-hero" class="topo-wash topo-wash-hero">
  <div class="container-field">
    <div
      class="mx-auto flex max-w-3xl flex-col items-center gap-7 py-10 text-center sm:py-16"
    >
      <h1
        class="text-balance font-heading text-4xl leading-[1.1] font-medium tracking-tight text-ink sm:text-5xl md:text-6xl"
      >
        {headline}
      </h1>

      <p class="max-w-xl text-pretty text-lg text-ink-muted sm:text-xl">
        Scout is a <span class="lexicon-chip">pack</span> your coding agent carries. Drop links in — Scout
        hands them back at the exact moment they apply.
      </p>

      <div class="mt-2 flex w-full max-w-xl flex-col items-center gap-3">
        <CopyBlock
          client:idle
          text={SITE.installCommand}
          label="the install command"
          goatcounterEvent="install-copy"
          className="w-full"
        />
        <p class="text-sm text-ink-faint">
          Free and open source. No server, no account, no API key.
        </p>
      </div>

      <StarCount client:idle className="mt-1" />
    </div>
  </div>
</section>
